<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | PopIt</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <nav class="w-full py-4 px-6 flex justify-between items-center bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200 shadow-sm transition-all">
        <a href="/" class="text-xl font-bold tracking-tight text-indigo-600">popit<span class="text-slate-400">.my.id</span></a>
        <a href="/" class="text-sm font-medium text-slate-500 hover:text-indigo-600">Home</a>
    </nav>

    <main class="flex-grow flex items-center justify-center p-4" x-data="uploadApp()">
        <div class="glass-panel w-full max-w-2xl rounded-3xl p-6 shadow-2xl relative">
            
            <div class="grid grid-cols-3 gap-1 p-1 bg-slate-100/50 rounded-2xl mb-6">
                <button @click="setTab('txt')" :class="tab === 'txt' ? 'bg-white shadow text-indigo-600' : 'text-slate-500'" class="py-2.5 rounded-xl font-medium text-sm transition-all">📝 Text</button>
                <button @click="setTab('img')" :class="tab === 'img' ? 'bg-white shadow text-indigo-600' : 'text-slate-500'" class="py-2.5 rounded-xl font-medium text-sm transition-all">🖼️ Image</button>
                <button @click="setTab('file')" :class="tab === 'file' ? 'bg-white shadow text-indigo-600' : 'text-slate-500'" class="py-2.5 rounded-xl font-medium text-sm transition-all">📁 File</button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Delete After</label>
                    <select x-model="duration" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
                        <option value="1m">1 Minute</option>
                        <option value="5m">5 Minutes</option>
                        <option value="30m">30 Minutes</option>
                        <option value="1h" selected>1 Hour</option>
                        <option value="12h">12 Hours</option>
                        <option value="1d">1 Day</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Custom ID (Optional)</label>
                    <div class="relative">
                        <span class="absolute left-3 top-3 text-slate-400 text-sm">/</span>
                        <input x-model="customId" type="text" placeholder="my-custom-link" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-6 pr-4 py-3 outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-mono" maxlength="20">
                    </div>
                </div>
            </div>

            <div x-show="errorMessage" x-transition class="mb-4 p-3 bg-red-50 text-red-600 text-sm rounded-lg border border-red-100 flex items-center gap-2">
                <span x-text="errorMessage"></span>
            </div>

            <div class="space-y-6">
                <div x-show="tab === 'txt'">
                    <textarea x-model="textContent" class="w-full h-48 bg-slate-50 border-0 ring-1 ring-slate-200 rounded-xl p-4 font-mono text-sm focus:ring-2 focus:ring-indigo-500 resize-none" placeholder="Paste text here..."></textarea>
                </div>
                <div x-show="tab !== 'txt'">
                    <div 
                        x-data="{ isDragging: false }"
                        @dragover.prevent="isDragging = true"
                        @dragleave.prevent="isDragging = false"
                        @drop.prevent="isDragging = false; handleDrop($event)"
                        @click="$refs.fileInput.click()"
                        :class="isDragging ? 'border-indigo-500 bg-indigo-50 scale-[0.99]' : 'border-slate-300 hover:bg-indigo-50 hover:border-indigo-400'"
                        class="border-2 border-dashed rounded-xl h-48 flex flex-col items-center justify-center cursor-pointer transition-all duration-200"
                    >
                        <input type="file" x-ref="fileInput" @change="handleFileSelect" class="hidden">
                        <template x-if="!fileName">
                            <div class="text-center pointer-events-none">
                                <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-2">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                                </div>
                                <p class="text-sm font-medium text-slate-600">Click to upload or Drag & Drop</p>
                            </div>
                        </template>
                        <template x-if="fileName">
                            <div class="text-center px-4 pointer-events-none">
                                <div class="text-3xl mb-2">✅</div>
                                <p class="font-bold text-slate-800 break-all line-clamp-1" x-text="fileName"></p>
                                <p class="text-xs text-slate-500" x-text="fileSize"></p>
                            </div>
                        </template>
                    </div>
                </div>

                <button @click="submitData" :disabled="isLoading" class="w-full bg-slate-900 hover:bg-black text-white font-bold py-4 rounded-xl shadow-lg flex justify-center items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed transition-all active:scale-95">
                    <span x-show="!isLoading">Generate Secure Link</span>
                    <span x-show="isLoading">Processing...</span>
                </button>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('uploadApp', () => ({
                tab: 'txt',
                duration: '1h',
                customId: '',
                textContent: '',
                file: null,
                fileName: '',
                fileSize: '',
                isLoading: false,
                errorMessage: '',
                setTab(val) { this.tab = val; this.errorMessage = ''; },
                handleFileSelect(e) { this.processFile(e.target.files[0]); },
                handleDrop(e) { if (e.dataTransfer.files.length > 0) this.processFile(e.dataTransfer.files[0]); },
                processFile(file) {
                    if (file) {
                        this.errorMessage = '';
                        if(file.size > 10 * 1024 * 1024) { this.errorMessage = "File Max 10MB"; return; }
                        this.file = file;
                        this.fileName = file.name;
                        this.fileSize = (file.size / 1024 / 1024).toFixed(2) + ' MB';
                    }
                },
                async submitData() {
                    this.errorMessage = '';
                    if (this.tab === 'txt' && !this.textContent) { this.errorMessage = 'Isi teks terlebih dahulu!'; return; }
                    if (this.tab !== 'txt' && !this.file) { this.errorMessage = 'Pilih file terlebih dahulu!'; return; }

                    this.isLoading = true;
                    const formData = new FormData();
                    formData.append('type', this.tab);
                    formData.append('duration', this.duration);
                    if(this.customId) formData.append('customId', this.customId);
                    if (this.tab === 'txt') formData.append('textContent', this.textContent);
                    else formData.append('file', this.file);

                    try {
                        const res = await fetch('/api/upload', { method: 'POST', body: formData });
                        const data = await res.json();
                        if (data.success) window.location.href = '/' + data.id;
                        else this.errorMessage = data.error || 'Upload failed';
                    } catch (err) { this.errorMessage = 'Network Error'; } 
                    finally { this.isLoading = false; }
                }
            }))
        })
    </script>
</body>
</html>
