<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | PopIt</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col items-center justify-center p-6 text-center">

    <div class="w-24 h-24 bg-red-50 text-red-500 rounded-full flex items-center justify-center mb-6">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>

    <h1 class="text-3xl font-bold text-slate-900 mb-2"><%= title %></h1>
    <p class="text-slate-500 max-w-md mx-auto mb-8"><%= message %></p>

    <a href="/" class="px-6 py-3 bg-slate-900 text-white rounded-xl font-medium hover:bg-black transition-colors">
        Kembali ke Home
    </a>

</body>
</html>
